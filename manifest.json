{
  "manifest_version": 3,
  "name": "EcoPrompt Coach",
  "version": "1.3.0",
  "description": "Making AI Sustainability Visible and Actionable - Track environmental impact of AI queries",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "EcoPrompt Coach"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://*.openai.com/*",
        "https://claude.ai/*",
        "https://*.anthropic.com/*",
        "https://gemini.google.com/*",
        "https://bard.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.bing.com/chat*",
        "https://poe.com/*",
        "https://*.perplexity.ai/*",
        "https://you.com/*",
        "https://*.mistral.ai/*",
        "https://chat.mistral.ai/*",
        "https://grok.com/*",
        "https://x.ai/*"
      ],
      "js": ["shared/analyzer.js", "shared/calculator.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "tooltip.css", "data/*.json", "shared/*.js"],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://*.openai.com/*",
        "https://claude.ai/*",
        "https://*.anthropic.com/*",
        "https://gemini.google.com/*",
        "https://bard.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.bing.com/chat*",
        "https://poe.com/*",
        "https://*.perplexity.ai/*",
        "https://you.com/*",
        "https://*.mistral.ai/*",
        "https://chat.mistral.ai/*",
        "https://grok.com/*",
        "https://x.ai/*"
      ]
    }
  ],
  "options_page": "settings.html"
}
