{
  "_metadata": {
    "version": "2.0.0",
    "last_updated": "2026-06-10",
    "primary_source": "Jegham et al. (2025), How Hungry is AI? Benchmarking Energy, Water, and Carbon Footprint of LLM Inference, arXiv:2505.09598 (v6, Nov 2025 — 30 models, DEA eco-efficiency ranking)",
    "anchor_sources": [
      "Google (Aug 2025), Measuring the environmental impact of delivering AI at Google, arXiv:2508.15734 — median Gemini Apps text prompt: 0.24 Wh, 0.26 mL water, 0.03 gCO2e (market-based, incl. embodied)",
      "OpenAI / Altman (Jun 2025), The Gentle Singularity — average ChatGPT query: ~0.34 Wh, ~0.32 mL water",
      "Mistral AI (Jul 2025), lifecycle analysis of Mistral Large 2 (ISO 14040/44, peer-reviewed) — 1.14 gCO2e and 45 mL water per 400-output-token response (full lifecycle)",
      "Epoch AI (Feb 2025), How much energy does ChatGPT use? — ~0.3 Wh per typical GPT-4o query; ~2.5 Wh at 10k-token input",
      "Oviedo et al. (Microsoft, 2025/Joule 2026), Energy Use of AI Inference, arXiv:2509.20241 — median 0.34 Wh/query (IQR 0.18-0.67) for >200B-param models in production; non-production extrapolations overstate 4-20x",
      "URI AI lab / Jegham dashboard (Aug 2025) — GPT-5 medium reasoning response: ~18.35 Wh average, up to ~40 Wh (contested estimate)",
      "Adamska et al. (2025), Green Prompting, arXiv:2503.10666 — response length is the dominant energy driver (r~0.9); input length matters far less"
    ],
    "notes": {
      "data_source_field": "measured = benchmarked in Jegham et al.; extrapolated = estimated from size class, hardware, and measured siblings; anchored = calibrated against a provider-reported per-prompt figure",
      "benchmark_configurations": "short = 100 in / 300 out, medium = 1000 in / 1000 out, long = 10000 in / 1500 out tokens",
      "reasoning_models": "Benchmark energy for reasoning models includes hidden chain-of-thought tokens at a typical thinking budget; the engine scales the decode term for low/standard/high effort."
    }
  },
