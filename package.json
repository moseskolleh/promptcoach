{
  "name": "ecoprompt-coach",
  "version": "2.0.0",
  "private": true,
  "description": "EcoPrompt Coach — make the energy, water, and carbon cost of every AI query visible, relatable, and actionable.",
  "workspaces": [
    "packages/core"
  ],
  "scripts": {
    "test": "node --test packages/core/test/*.test.js && node scripts/check-apps.js",
    "test:core": "node --test packages/core/test/*.test.js",
    "check": "node scripts/check-apps.js",
    "sync": "node scripts/sync-core.js",
    "web": "npx serve apps/web",
    "demo": "npx serve apps/demo"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
